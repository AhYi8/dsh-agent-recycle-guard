{
  "name": "dsh-agent-recycle-guard",
  "version": "1.2.0",
  "description": "DSH 删除防护插件：直接删除转入系统回收站，脚本内容尽力检查，支持 Windows、Linux 与 macOS。",
  "type": "module",
  "main": "./lib/plugin.js",
  "scripts": {
    "prepack": "node scripts/prepack.js",
    "postpack": "node scripts/postpack.js",
    "test": "node --test tests/runtime.test.mjs && python -X utf8 tests/run_all.py"
  },
  "exports": {
    ".": "./lib/plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "tests",
    "lib/uv-artifacts.json",
    "guard/guard.py",
    "guard/shell_commands.py",
    "guard/script_checks.py",
    "guard/parse_powershell.ps1",
    "guard/recycle_powershell.ps1",
    "guard/recycle_powershell_impl.ps1",
    "guard/recycle.cmd",
    "cordis.patch.yml",
    "requirements.txt",
    "requirements-dev.txt",
    "README.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "recycle-bin",
    "delete-guard",
    "safety"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
